# Session — secret untuk menandatangani cookie login.
# Opsional saat development: kalau kosong, secret acak dibuat sekali & disimpan di app.db.
# Wajib diisi di production (dan sama di semua instance).
SESSION_SECRET=

# Web Push — kunci VAPID untuk kirim notifikasi walau app tertutup.
# Opsional saat development: kalau kosong, pasangan kunci dibuat sekali & disimpan
# di app.db (generate manual: `npx web-push generate-vapid-keys`).
# Wajib diisi & sama di semua instance saat production (subscription lama jadi
# tidak valid kalau public key server berubah).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pesan.in

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Polygon (Amoy testnet untuk development, mainnet untuk production)
#
# Escrow on-chain default-nya MATI. Selama salah satu dari tiga variabel di bawah
# masih kosong (atau contract address masih address nol), aplikasi tetap jalan
# penuh dengan tx hash simulasi — tidak perlu setup apa pun untuk development.
#
# Untuk mengaktifkan payout sungguhan: deploy contracts/PesaninEscrow.sol, isi
# alamat hasil deploy di bawah, lalu isi PLATFORM_PRIVATE_KEY.
NEXT_PUBLIC_POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
NEXT_PUBLIC_POLYGON_CHAIN_ID=80002
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Kunci owner contract, dipakai server untuk assignDriver() & settleOrder()
# (keduanya onlyOwner). JANGAN commit — dan pakai wallet khusus operasional,
# bukan wallet pribadi. Kalau kosong, escrow on-chain tetap mati.
PLATFORM_PRIVATE_KEY=

# Deploy-time only
DEPLOYER_PRIVATE_KEY=
